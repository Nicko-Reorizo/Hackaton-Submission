PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/mynaga
CORS_ORIGINS=http://localhost:5173

# Firebase Admin: use application default credentials (recommended), or all three
# service account fields below. Never put a service account in a frontend.
FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Create the official's email/password account in Firebase Auth, then list its UID.
# Alternatively, set a verified Firebase custom claim { lgu: true } on that user.
LGU_ALLOWED_UIDS=

GEMINI_API_KEY=
# Available image-capable model; older 1.5 is retired and 2.5 is blocked for new users.
# Model access and free-tier quotas depend on your AI Studio account.
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated exact HTTPS hostnames; redirects and arbitrary URLs are blocked.
IMAGE_ALLOWED_HOSTS=res.cloudinary.com,firebasestorage.googleapis.com,storage.googleapis.com

# Cloudinary Free Image & Video API account. Find these in Settings > API Keys.
# These credentials belong ONLY in backend/.env, never in EXPO_PUBLIC_ or VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, only for historical Firebase Storage URLs; no Firebase bucket needed.
# FIREBASE_STORAGE_BUCKET=
